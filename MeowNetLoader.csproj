<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>MeowNetLoader</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="MeowNetLoader.AppIcon" />
    <None Remove="MeowNetLoader.Background" />
    <None Remove="MeowNetLoader.Desktop" />
    <None Remove="MeowNetLoader.Meta" />
    <None Remove="MeowNetLoader.Pfp" />
    <EmbeddedResource Include="MeowNetLoader.AppIcon" LogicalName="MeowNetLoader.AppIcon" />
    <EmbeddedResource Include="MeowNetLoader.Background" LogicalName="MeowNetLoader.Background" />
    <EmbeddedResource Include="MeowNetLoader.Desktop" LogicalName="MeowNetLoader.Desktop" />
    <EmbeddedResource Include="MeowNetLoader.Meta" LogicalName="MeowNetLoader.Meta" />
    <EmbeddedResource Include="MeowNetLoader.Pfp" LogicalName="MeowNetLoader.Pfp" />
  </ItemGroup>
  <ItemGroup />
</Project>